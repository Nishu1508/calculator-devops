# Copy to jenkins/.env (git-ignored) or run setup-secrets.ps1 to generate it.
GITHUB_REPO_URL=https://github.com/<github-user>/calculator-devops
DOCKERHUB_USERNAME=<dockerhub-user>
SMTP_USERNAME=<sender>@gmail.com
NOTIFY_EMAIL=<receiver>@gmail.com
JENKINS_ADMIN_ID=admin
JENKINS_URL=http://localhost:8080/

# Secrets live in jenkins/secrets/ (also git-ignored), one value per file, no newline:
#   jenkins/secrets/jenkins_admin_password
#   jenkins/secrets/dockerhub_token
#   jenkins/secrets/smtp_app_password
